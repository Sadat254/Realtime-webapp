* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: 'Segoe UI', sans-serif;
  background: #0f172a;
  color: #e2e8f0;
  min-height: 100vh;
}

header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem 2rem;
  background: #1e293b;
  border-bottom: 1px solid #334155;
  font-size: 0.9rem;
  color: #94a3b8;
}

.logo { font-size: 1.2rem; font-weight: 600; color: #38bdf8; }

main { padding: 2rem; max-width: 1100px; margin: 0 auto; }

.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1rem;
  margin-bottom: 2rem;
}

.card {
  background: #1e293b;
  border: 1px solid #334155;
  border-radius: 12px;
  padding: 1.5rem;
  text-align: center;
  transition: transform 0.2s;
}

.card:hover { transform: translateY(-3px); }
.card-icon { font-size: 2rem; }
.card-label { color: #94a3b8; font-size: 0.85rem; margin: 0.5rem 0 0.25rem; }
.card-value { font-size: 1.8rem; font-weight: 700; color: #38bdf8; }

.chat-section h2 {
  font-size: 1.1rem;
  margin-bottom: 1rem;
  color: #94a3b8;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.chat-box {
  background: #1e293b;
  border: 1px solid #334155;
  border-radius: 12px;
  height: 320px;
  overflow-y: auto;
  padding: 1rem;
  margin-bottom: 1rem;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.msg {
  background: #0f172a;
  border-radius: 8px;
  padding: 8px 12px;
  font-size: 0.9rem;
  border-left: 3px solid #38bdf8;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; } }

.msg .author { font-weight: 600; color: #38bdf8; margin-right: 8px; }
.msg .time { font-size: 0.75rem; color: #64748b; float: right; }

#chat-form {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

#chat-form input {
  flex: 1;
  min-width: 120px;
  padding: 10px 14px;
  background: #1e293b;
  border: 1px solid #334155;
  border-radius: 8px;
  color: #e2e8f0;
  font-size: 0.9rem;
}

#chat-form input:focus { outline: none; border-color: #38bdf8; }

#chat-form button {
  padding: 10px 20px;
  background: #38bdf8;
  color: #0f172a;
  border: none;
  border-radius: 8px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.2s;
}

#chat-form button:hover { background: #0ea5e9; }
